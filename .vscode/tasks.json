{
    "version": "2.0.0",
    "inputs": [
        {
            "id": "labFolder",
            "type": "pickString",
            "description": "Which Lab do you want to compile and run?",
            "options": [
                "Session1",
                "Session2"
            ],
            "default": "Session1"
        }
    ],
    "tasks": [
        {
            "type": "shell",
            "label": "C/C++: Build Selected Lab",
            "command": "/usr/bin/clang++",
            "args": [
                "-std=c++23",
                "-fdiagnostics-color=always",
                "-g",
                "src/*.cpp",
                "src/lib/*.cpp",
                "-o",
                "${workspaceFolder}/main",
                "-I",
                "include"
            ],
            "options": {
                "cwd": "${workspaceFolder}/${input:labFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}